<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<HBox styleClass="root" stylesheets="@javafx-style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.secondbrain.controller.LoginController"
      prefWidth="900" prefHeight="600">

    <!-- LEFT: Branding strip -->
    <VBox prefWidth="340" alignment="CENTER" spacing="24"
          style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e1b4b);
                 -fx-padding: 56 40;
                 -fx-border-color: rgba(255,255,255,0.06);
                 -fx-border-width: 0 1 0 0;">

        <HBox alignment="CENTER" spacing="12">
            <Circle radius="12" fill="#3b82f6"
                    style="-fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.7), 14, 0, 0, 0);"/>
            <Label text="Second Brain"
                   style="-fx-text-fill: #f8fafc; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>

        <Label text="Your AI-powered knowledge companion"
               style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
               wrapText="true" alignment="CENTER"/>

        <Region style="-fx-background-color: rgba(255,255,255,0.06); -fx-min-height: 1;"
                maxWidth="200"/>

        <!-- Quick stats -->
        <VBox spacing="12" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#3b82f6"/>
                <Label text="Upload PDFs as AI context"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#10b981"/>
                <Label text="Collaborate in Group chats"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#f59e0b"/>
                <Label text="10 free AI tokens on signup"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#a78bfa"/>
                <Label text="Private per-user document library"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>

    </VBox>

    <!-- RIGHT: Login Form -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="20"
          style="-fx-background-color: #0f172a; -fx-padding: 60 64;">

        <VBox spacing="6" alignment="CENTER">
            <Label text="Welcome back"
                   style="-fx-text-fill: #f8fafc; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="Sign in to your Second Brain account"
                   style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Form fields -->
        <VBox spacing="16" maxWidth="340">
            <VBox spacing="6">
                <Label text="Username" styleClass="small-text"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           styleClass="chat-input"
                           style="-fx-pref-height: 42px; -fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="small-text"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="chat-input"
                               style="-fx-pref-height: 42px; -fx-font-size: 14px;"/>
            </VBox>

            <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="340"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px;
                          -fx-background-color: rgba(239,68,68,0.08);
                          -fx-background-radius: 8; -fx-padding: 8 12;"/>

            <!-- Primary action -->
            <Button text="Sign In →" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary"
                    style="-fx-pref-height: 44px; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <!-- Register -->
            <Button text="Create New Account" onAction="#handleRegister"
                    maxWidth="Infinity" styleClass="btn-upgrade"
                    style="-fx-pref-height: 42px; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Footer hint -->
        <Label text="New users get 10 free AI tokens. No credit card required."
               style="-fx-text-fill: #334155; -fx-font-size: 11px;"
               wrapText="true" alignment="CENTER" maxWidth="340"/>
    </VBox>

</HBox>
