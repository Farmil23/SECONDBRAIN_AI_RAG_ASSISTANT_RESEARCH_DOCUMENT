<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<HBox stylesheets="@javafx-style.css" styleClass="root"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.secondbrain.controller.MainController"
      prefWidth="1140" prefHeight="700">

    <!-- ============================================================ -->
    <!-- COL 1: SIDEBAR KIRI (240px)                                  -->
    <!-- ============================================================ -->
    <VBox prefWidth="240" minWidth="220" maxWidth="260" styleClass="sidebar" spacing="0">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 16 0;">
            <Circle radius="7" fill="#3b82f6"/>
            <Label text="Second Brain" styleClass="header-text"/>
        </HBox>

        <Label fx:id="statusLabel" text="Ready" styleClass="small-text"
               style="-fx-padding: 0 0 14 0;" wrapText="true"/>

        <!-- User Profile Card -->
        <VBox styleClass="user-profile">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                    <Circle radius="5" fill="#cbd5e1"/>
                    <Label text="Profile" styleClass="text"
                           style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>
                <Label fx:id="tierLabel" text="FREE" styleClass="tier-badge"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 8 0 10 0;">
                <Label text="Tokens:" styleClass="small-text"/>
                <Label fx:id="tokensLabel" text="10 Tokens"
                       style="-fx-text-fill: #f59e0b; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Upgrade" onAction="#handleUpgrade" styleClass="btn-upgrade"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Button fx:id="btnAdmin" text="⚙ Admin" onAction="#handleOpenAdmin"
                    styleClass="btn-sm-blue" maxWidth="Infinity"
                    visible="false" managed="false"
                    style="-fx-padding: 5 10; -fx-font-size: 11px; -fx-margin: 6 0 0 0;"/>
        </VBox>

        <!-- DIVIDER -->
        <Region styleClass="divider-line" style="-fx-margin: 14 0;"/>

        <!-- NAV -->
        <Label text="NAVIGATE" styleClass="section-label"/>
        <VBox spacing="5" style="-fx-padding: 0 0 6 0;">
            <Button fx:id="btnNavWorkspace" text="📁  Workspaces"
                    onAction="#handleSwitchToWorkspace"
                    styleClass="nav-btn-workspace-active" maxWidth="Infinity"/>
            <Button fx:id="btnNavGroup" text="👥  Groups"
                    onAction="#handleSwitchToGroup"
                    styleClass="nav-btn" maxWidth="Infinity"/>
        </VBox>

        <!-- DIVIDER -->
        <Region styleClass="divider-line"/>

        <!-- ═══ WORKSPACE SIDE PANEL ═══ -->
        <VBox fx:id="workspaceSidePanel" VBox.vgrow="ALWAYS" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 10 0 6 0;">
                <Label text="CHATS" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                <Button text="+ New" onAction="#handleNewChat" styleClass="btn-sm-blue"
                        style="-fx-padding: 3 8; -fx-font-size: 10px;"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="chatSessionList" spacing="4"
                      style="-fx-background-color: transparent; -fx-padding: 0 2 0 0;"/>
            </ScrollPane>
        </VBox>

        <!-- ═══ GROUP SIDE PANEL ═══ -->
        <VBox fx:id="groupSidePanel" VBox.vgrow="ALWAYS" spacing="0"
              visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 10 0 6 0;">
                <Label text="MY GROUPS" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                <Button text="+ New" onAction="#handleNewGroupChat" styleClass="btn-sm-green"
                        style="-fx-padding: 3 8; -fx-font-size: 10px;"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="groupSessionList" spacing="4"
                      style="-fx-background-color: transparent; -fx-padding: 0 2 0 0;"/>
            </ScrollPane>
            <Label text="💡 Mention @badsfarmil to invoke AI"
                   styleClass="small-text" wrapText="true"
                   style="-fx-padding: 8; -fx-background-color: rgba(16,185,129,0.06);
                          -fx-background-radius: 8; -fx-border-color: rgba(16,185,129,0.12);
                          -fx-border-radius: 8; -fx-border-width: 1;"/>
        </VBox>

    </VBox><!-- END SIDEBAR -->


    <!-- ============================================================ -->
    <!-- COL 2: MAIN CHAT AREA (flexible)                             -->
    <!-- ============================================================ -->
    <VBox HBox.hgrow="ALWAYS" styleClass="main-chat-area">

        <!-- Chat Header -->
        <HBox fx:id="chatHeader" alignment="CENTER_LEFT" spacing="10"
              styleClass="chat-header-workspace">
            <Circle fx:id="headerDot" radius="5" fill="#3b82f6"/>
            <Label fx:id="chatTitleLabel" text="Select or create a chat"
                   styleClass="header-text" HBox.hgrow="ALWAYS"/>
            <Label fx:id="modeBadgeLabel" text="WORKSPACE" styleClass="mode-badge-workspace"/>

            <!-- Doc context button (only meaningful in workspace mode) -->
            <Button fx:id="btnToggleDocPanel" text="📎 Docs"
                    onAction="#handleToggleDocPanel"
                    styleClass="btn-sm"
                    visible="true"/>
        </HBox>

        <!-- Assigned docs indicator (shown under header when docs are assigned) -->
        <HBox fx:id="assignedDocsBar" spacing="6" alignment="CENTER_LEFT"
              style="-fx-padding: 4 0 8 0;" visible="false" managed="false">
            <Label text="Context:" styleClass="small-text"
                   style="-fx-text-fill: #3b82f6; -fx-font-weight: bold;"/>
            <HBox fx:id="assignedDocChips" spacing="4" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Chat History -->
        <ScrollPane fx:id="chatScroll" fitToWidth="true" styleClass="chat-scroll-pane"
                    VBox.vgrow="ALWAYS" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox fx:id="chatHistoryBox" styleClass="chat-history-box"/>
        </ScrollPane>

        <!-- Input Area -->
        <VBox spacing="8">
            <!-- Group AI hint bar (visible only in group mode) -->
            <HBox fx:id="groupAiHintBar" spacing="8" alignment="CENTER_LEFT"
                  visible="false" managed="false"
                  style="-fx-padding: 6 12;
                         -fx-background-color: rgba(16,185,129,0.07);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(16,185,129,0.15);
                         -fx-border-radius: 10;
                         -fx-border-width: 1;">
                <Label text="🤖" style="-fx-font-size: 13px;"/>
                <Label text="Click  Ask AI  to send a message directly to Jarvis AI"
                       style="-fx-text-fill: #6ee7b7; -fx-font-size: 11px;" HBox.hgrow="ALWAYS"/>
                <Button text="Ask AI →" fx:id="btnAskAI"
                        onAction="#handleAskAI"
                        style="-fx-background-color: rgba(16,185,129,0.2);
                               -fx-text-fill: #6ee7b7; -fx-font-weight: bold;
                               -fx-font-size: 11px; -fx-padding: 4 12;
                               -fx-background-radius: 20;
                               -fx-border-color: rgba(16,185,129,0.35);
                               -fx-border-radius: 20; -fx-border-width: 1;
                               -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="inputField"
                           promptText="Ask about your documents..."
                           styleClass="chat-input"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleSend"/>
                <Button fx:id="sendButton" text="Send ➤" onAction="#handleSend"
                        styleClass="btn-primary"/>
            </HBox>
        </VBox>

    </VBox><!-- END MAIN AREA -->


    <!-- ============================================================ -->
    <!-- COL 3: DOCUMENT PANEL (300px, toggle)                        -->
    <!-- ============================================================ -->
    <VBox fx:id="docPanel" prefWidth="300" minWidth="280" maxWidth="320"
          visible="false" managed="false"
          style="-fx-background-color: #111827;
                 -fx-border-color: rgba(255,255,255,0.06);
                 -fx-border-width: 0 0 0 1;
                 -fx-padding: 20 16 20 16;
                 -fx-spacing: 12;">

        <!-- Panel Header -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="📎 Documents" styleClass="sub-header-text"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#handleToggleDocPanel" styleClass="btn-icon"
                    style="-fx-font-size: 14px;"/>
        </HBox>

        <Label text="Your document library. Toggle to attach docs as AI context for this chat."
               styleClass="small-text" wrapText="true"/>

        <Region styleClass="divider-line"/>

        <!-- Upload button -->
        <Button text="+ Upload New PDF" onAction="#handleUpload"
                styleClass="btn-sm-blue" maxWidth="Infinity"
                style="-fx-padding: 8 12; -fx-font-size: 12px;"/>

        <!-- Sections -->
        <Label text="ATTACHED TO THIS CHAT" styleClass="section-label"
               style="-fx-text-fill: #3b82f6;"/>
        <ScrollPane fitToWidth="true" prefHeight="180" maxHeight="200"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox fx:id="attachedDocList" spacing="4"
                  style="-fx-background-color: transparent;"/>
        </ScrollPane>

        <Region styleClass="divider-line"/>

        <Label text="ALL YOUR DOCUMENTS" styleClass="section-label"/>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox fx:id="allDocList" spacing="4"
                  style="-fx-background-color: transparent;"/>
        </ScrollPane>

        <!-- Action buttons -->
        <Region styleClass="divider-line"/>
        <Button text="+ New Chat with Selected Docs" onAction="#handleNewChatWithDocs"
                styleClass="btn-sm-blue" maxWidth="Infinity"
                style="-fx-padding: 9 12; -fx-font-size: 12px;"/>

    </VBox><!-- END DOC PANEL -->

</HBox>